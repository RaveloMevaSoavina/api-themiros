# Public DNS name pointing to this server. Do not include https:// or a path.
API_DOMAIN=api.example.com

APP_ENV=production
APP_DEBUG=false
CORS_ALLOWED_ORIGINS=https://dashboard.example.com

# Supabase server-side configuration.
SUPABASE_URL=https://supabase.example.com
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key
SUPABASE_JWT_AUDIENCE=authenticated

# OpenAI configuration.
AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-the-openai-api-key
OPENAI_MODEL=gpt-6-astra
OPENAI_TIMEOUT_SECONDS=30
OPENAI_INPUT_COST_EUR_PER_MILLION=0
OPENAI_OUTPUT_COST_EUR_PER_MILLION=0
AI_MAX_COST_EUR=0

# Optional immutable tag for a release, for example a Git commit SHA.
IMAGE_TAG=latest

