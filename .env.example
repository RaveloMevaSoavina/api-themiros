APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase server-side configuration. Never expose the service role key in Vite.
SUPABASE_URL=https://supabase.example.com
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_AUDIENCE=authenticated

# OpenAI Responses API. Keep the key server-side only.
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6-astra
OPENAI_TIMEOUT_SECONDS=30
# Optional accounting values; leave at 0 until your contract prices are known.
OPENAI_INPUT_COST_EUR_PER_MILLION=0
OPENAI_OUTPUT_COST_EUR_PER_MILLION=0
# 0 disables the per-call cost ceiling.
AI_MAX_COST_EUR=0

# Ingestion documentaire (E4). Les seuils métier (70/40, bonus, malus) sont
# dans la table Supabase `ingestion_settings`, pas ici.
INGESTION_WORKER_CONCURRENCY=2
INGESTION_WORKER_LEASE_SECONDS=300
INGESTION_WORKER_POLL_SECONDS=2
# Embeddings calculés localement (fastembed, ~1 Go de modèle, CPU). Pour
# OpenAI : INGESTION_EMBEDDING_PROVIDER=openai et
# INGESTION_EMBEDDING_MODEL=text-embedding-3-small (réduit à 768 dimensions).
# Changer de modèle impose de réindexer le corpus.
INGESTION_EMBEDDING_PROVIDER=local
INGESTION_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2-int8
# Segments vectorisés pour le score de pertinence (le reste à l'indexation).
INGESTION_RELEVANCE_SAMPLE_SEGMENTS=32
INGESTION_EMBEDDING_DIMENSIONS=768
INGESTION_EMBEDDING_CACHE_DIR=.cache/fastembed
INGESTION_OCR_BASE_LANGUAGES=fra+eng
INGESTION_OCR_PARALLELISM=4
INGESTION_NER_MODEL=xx_ent_wiki_sm
