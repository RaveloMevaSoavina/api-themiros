APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase server-side configuration. Never expose the service role key in Vite.
SUPABASE_URL=https://supabase.example.com
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_AUDIENCE=authenticated

# OpenAI Responses API. Keep the key server-side only.
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6-astra
OPENAI_TIMEOUT_SECONDS=30
# Tarifs OpenAI standard au 28/10/2026 (gpt-6-astra : 10 $ / 50 $ par million
# de tokens en entrée / sortie ; text-embedding-3-large : 0,13 $), convertis au
# taux BCE du 27/10/2026 (1 EUR = 1,1150 USD). À revoir si les tarifs changent.
OPENAI_INPUT_COST_EUR_PER_MILLION=8.97
OPENAI_OUTPUT_COST_EUR_PER_MILLION=44.84
OPENAI_EMBEDDING_COST_EUR_PER_MILLION=0.1166
# 0 disables the per-call cost ceiling.
AI_MAX_COST_EUR=0

# Ingestion documentaire (E4). Les seuils métier (70/40, bonus, malus) sont
# dans la table Supabase `ingestion_settings`, pas ici.
INGESTION_WORKER_CONCURRENCY=2
INGESTION_WORKER_LEASE_SECONDS=300
INGESTION_WORKER_POLL_SECONDS=2
# Embeddings OpenAI réduits à 768 dimensions (OPENAI_API_KEY requis). Le
# modèle local reste possible : INGESTION_EMBEDDING_PROVIDER=local et
# INGESTION_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2-int8.
# Changer de modèle impose de réindexer le corpus
# (python -m app.modules.ingestion.reindex) et de recalibrer les seuils.
INGESTION_EMBEDDING_PROVIDER=openai
INGESTION_EMBEDDING_MODEL=text-embedding-3-large
# Similarité minimale extrait / sous-question (couche B), propre au modèle.
RUN_LAYER_B_MIN_SIMILARITY=0.32
# Similarité « forte » d'une détection (variable à 1), propre au modèle.
RUN_STRONG_SIMILARITY=0.43
# Segments vectorisés pour le score de pertinence (le reste à l'indexation).
INGESTION_RELEVANCE_SAMPLE_SEGMENTS=32
INGESTION_EMBEDDING_DIMENSIONS=768
INGESTION_EMBEDDING_CACHE_DIR=.cache/fastembed
INGESTION_OCR_BASE_LANGUAGES=fra+eng
INGESTION_OCR_PARALLELISM=4
INGESTION_NER_MODEL=xx_ent_wiki_sm
